# Subcommands: Unlock & Keycodes
cmd_unlock() {
    check_device
    local pin="$1"
    if [ -z "$pin" ]; then
        echo -n "Enter Device Lock PIN (masked): "
        read -rs pin
        echo ""
    fi

    log_info "Forcing device wakeup..."
    "$ADB" shell input keyevent KEYCODE_WAKEUP
    "$ADB" shell input keyevent 224 # KEYCODE_WAKEUP
    sleep 0.3

    log_info "Collapsing notification shade & opening keypad..."
    "$ADB" shell cmd statusbar collapse 2>/dev/null || true
    "$ADB" shell input keyevent KEYCODE_MENU 2>/dev/null || true
    
    # Dynamic coordinate computation based on current wm size
    local dims width height x_mid y_start y_end
    dims=$(get_screen_dimensions)
    width=$(echo "$dims" | cut -dx -f1)
    height=$(echo "$dims" | cut -dx -f2)
    x_mid=$((width / 2))
    y_start=$((height * 85 / 100))
    y_end=$((height * 25 / 100))

    "$ADB" shell input swipe "$x_mid" "$y_start" "$x_mid" "$y_end" 150
    sleep 0.5

    log_info "Transmitting PIN keycodes..."
    for (( i=0; i<${#pin}; i++ )); do
        digit="${pin:$i:1}"
        case "$digit" in
            0) key=7 ;;
            1) key=8 ;;
            2) key=9 ;;
            3) key=10 ;;
            4) key=11 ;;
            5) key=12 ;;
            6) key=13 ;;
            7) key=14 ;;
            8) key=15 ;;
            9) key=16 ;;
            *) key="" ;;
        esac
        if [ -n "$key" ]; then
            "$ADB" shell input keyevent "$key"
            sleep 0.08
        fi
    done
    
    # Enter / Confirm
    "$ADB" shell input keyevent 66
    pin="" # Wipe from memory
    log_ok "Unlock sequence completed!"
}

