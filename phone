# Subcommands: Communications & Diagnostics
cmd_notifs() {
    check_device
    echo -e "\n${BOLD}${MAGENTA}╔═════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${MAGENTA}║                  LIVE NOTIFICATION & OTP STREAM                 ║${RESET}"
    echo -e "${BOLD}${MAGENTA}╚═════════════════════════════════════════════════════════════════╝${RESET}\n"

    local raw_dump
    raw_dump=$("$ADB" shell dumpsys notification --noredact 2>/dev/null || true)

    # Parse notification titles and texts using python
    python3 -c '
import sys, re

content = sys.stdin.read()
records = content.split("NotificationRecord(")

found = 0
for r in records[1:]:
    pkg_match = re.search(r"pkg=([^\s]+)", r)
    title_match = re.search(r"android\.title=String \((.*?)\)", r)
    text_match = re.search(r"android\.text=String \((.*?)\)", r)
    ticker_match = re.search(r"tickerText=(.*?)\n", r)

    pkg = pkg_match.group(1) if pkg_match else "Unknown"
    title = title_match.group(1) if title_match else ""
    text = text_match.group(1) if text_match else ""
    
    # Skip noise / persistent service notifications
    if pkg in ["android", "com.android.systemui"] and "USB" in text:
        continue
    if not title and not text:
        continue

    found += 1
    # Check for OTP patterns (4-8 digits)
    otp_candidate = ""
    otp_search = re.findall(r"\b\d{4,8}\b", f"{title} {text}")
    if any(k in f"{title} {text}".lower() for k in ["otp", "code", "verification", "pin", "login", "password"]):
        if otp_search:
            otp_candidate = f" \033[1;33m[🔑 OTP Detected: {otp_search[0]}]\033[0m"

    print(f"\033[1;36m• [{pkg}]\033[0m \033[1m{title}\033[0m{otp_candidate}")
    print(f"  \033[2m{text}\033[0m\n")

if found == 0:
    print("  (No active user notifications found)")
' <<< "$raw_dump"
}

cmd_calls() {
    check_device
    echo -e "\n${BOLD}${BLUE}╔═════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${BLUE}║                     RECENT CALL HISTORY LOG                     ║${RESET}"
    echo -e "${BOLD}${BLUE}╚═════════════════════════════════════════════════════════════════╝${RESET}\n"

    local raw_calls
    raw_calls=$("$ADB" shell "content query --uri content://call_log/calls --projection number:name:type:date:duration" 2>/dev/null || true)

    python3 -c '
import sys, datetime, re

lines = sys.stdin.readlines()
count = 0
for line in lines[:15]:
    if not line.startswith("Row:"):
        continue
    num_m = re.search(r"number=([^,\s]+)", line)
    name_m = re.search(r"name=([^,\s]+)", line)
    type_m = re.search(r"type=([^,\s]+)", line)
    date_m = re.search(r"date=([^,\s]+)", line)
    dur_m = re.search(r"duration=([^,\s]+)", line)

    number = num_m.group(1) if num_m else "Unknown"
    name = name_m.group(1) if name_m and name_m.group(1) != "NULL" else number
    ctype = type_m.group(1) if type_m else "1"
    timestamp = int(date_m.group(1)) / 1000 if date_m else 0
    duration = dur_m.group(1) if dur_m else "0"

    date_str = datetime.datetime.fromtimestamp(timestamp).strftime("%Y-%m-%d %H:%M") if timestamp else "N/A"

    # Call types: 1: Incoming, 2: Outgoing, 3: Missed, 5: Rejected
    if ctype == "1":
        badge = "\033[1;32m[INCOMING]\033[0m"
    elif ctype == "2":
        badge = "\033[1;34m[OUTGOING]\033[0m"
    elif ctype == "3":
        badge = "\033[1;31m[MISSED]\033[0m"
    else:
        badge = f"[OTHER ({ctype})]"

    print(f" {badge} \033[1m{name}\033[0m ({number}) | {duration}s | \033[2m{date_str}\033[0m")
    count += 1

if count == 0:
    print("  (No call logs found)")
' <<< "$raw_calls"
    echo ""
}

cmd_dial() {
    check_device
    local target="$1"
    if [ -z "$target" ]; then
        log_error "Please specify a phone number to dial. Usage: phone dial <number>"
        exit 1
    fi
    log_info "Initiating phone call to: ${BOLD}$target${RESET}..."
    "$ADB" shell am start -a android.intent.action.CALL -d "tel:$target"
    log_ok "Dialer intent transmitted!"
}

cmd_answer() {
    check_device
    log_info "Accepting incoming call..."
    "$ADB" shell input keyevent KEYCODE_HEADSETHOOK || "$ADB" shell input keyevent KEYCODE_CALL
    log_ok "Call answered."
}

cmd_hangup() {
    check_device
    log_info "Ending call..."
    "$ADB" shell input keyevent KEYCODE_ENDCALL
    log_ok "Call ended."
}

cmd_app() {
    check_device
    local query="$1"
    if [ -z "$query" ]; then
        log_error "Usage: phone open <app_name> (e.g. phone open whatsapp, phone open settings)"
        exit 1
    fi

    log_info "Searching for package matching '${BOLD}$query${RESET}'..."
    local match
    match=$("$ADB" shell pm list packages | grep -i "$query" | head -n1 | cut -d: -f2 | tr -d '\r\n' || true)

    if [ -z "$match" ]; then
        log_error "No package found matching '$query'."
        echo -e "\nInstalled third-party packages sample:"
        "$ADB" shell pm list packages -3 | head -n 10 | cut -d: -f2
        exit 1
    fi

    log_info "Launching package: ${GREEN}$match${RESET}..."
    "$ADB" shell monkey -p "$match" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
    log_ok "Launched $match!"
}

cmd_clip() {
    check_device
    if [ -n "$1" ]; then
        log_info "Safely transferring text to phone clipboard (Base64 Sanitized)..."
        local b64_payload
        b64_payload=$(printf '%s' "$1" | base64 -w 0)
        "$ADB" shell "echo '$b64_payload' | base64 -d > /data/local/tmp/aegis_clip.txt"
        "$ADB" shell "export TEXT=\$(cat /data/local/tmp/aegis_clip.txt); cmd clipboard set \"\$TEXT\" 2>/dev/null || input text \"\$(cat /data/local/tmp/aegis_clip.txt | tr ' ' '%s')\""
        "$ADB" shell rm -f /data/local/tmp/aegis_clip.txt
        log_ok "Text injected into phone clipboard successfully!"
    else
        log_info "Fetching phone clipboard text..."
        "$ADB" shell service call clipboard 2 s16 "com.android.shell" 2>/dev/null || true
    fi
}

cmd_push() {
    check_device
    local file_path="$1"
    local dest_folder="${2:-/sdcard/Pictures/}"

    if [ -z "$file_path" ] || [ ! -e "$file_path" ]; then
        log_error "File does not exist: $file_path"
        exit 1
    fi

    local filename
    filename=$(basename "$file_path")
    log_info "Pushing ${BOLD}$filename${RESET} to device ${CYAN}$dest_folder${RESET}..."
    "$ADB" push "$file_path" "$dest_folder"
    
    # Broadcast media scanner so Gallery/WhatsApp/Instagram pick it up instantly
    "$ADB" shell am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d "file://${dest_folder}${filename}" >/dev/null 2>&1 || true
    log_ok "File transferred! It will appear instantly in your phone Gallery/Files."
}

cmd_battery_watch() {
    check_device
    log_info "Starting Safe-Charging & Thermal Watchdog Daemon (Press Ctrl+C to stop)..."
    while true; do
        local dump level temp status
        dump=$("$ADB" shell dumpsys battery 2>/dev/null || true)
        level=$(echo "$dump" | awk '/level:/ {print $2}' | tr -d '\r\n')
        temp=$(echo "$dump" | awk '/temperature:/ {print $2/10}' | tr -d '\r\n')
        status=$(echo "$dump" | awk '/status:/ {print $2}' | tr -d '\r\n')

        echo -ne "\r${CYAN}⚡ Battery:${RESET} ${YELLOW}${level}%${RESET} | ${CYAN}Temp:${RESET} ${temp}°C | Status: ${status}    "

        # Overheat alert (> 42°C)
        if (( $(echo "$temp > 42.0" | bc -l) )); then
            notify-send -u critical "⚠️ PHONE OVERHEATING!" "Temperature reached ${temp}°C. Unplug immediately!" 2>/dev/null || true
            paplay /usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga 2>/dev/null || true
        fi

        # Full charge protection alert (> 85%)
        if [ "$level" -ge 85 ] && [ "$status" -eq 2 ]; then
            notify-send "🔋 Phone Charged to ${level}%" "Battery is sufficiently charged. You can unplug the charger." 2>/dev/null || true
        fi
        sleep 5
    done
}

cmd_status() {
    check_device
    echo -e "\n${BOLD}${BLUE}╔═════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${BLUE}║                     DEVICE STATUS DASHBOARD                     ║${RESET}"
    echo -e "${BOLD}${BLUE}╚═════════════════════════════════════════════════════════════════╝${RESET}\n"

    local model brand android_ver ip battery_level battery_temp battery_status storage_info dims
    model=$("$ADB" shell getprop ro.product.model | tr -d '\r\n')
    brand=$("$ADB" shell getprop ro.product.brand | tr -d '\r\n')
    android_ver=$("$ADB" shell getprop ro.build.version.release | tr -d '\r\n')
    dims=$(get_screen_dimensions)
    ip=$(get_phone_ip)
    
    local battery_dump
    battery_dump=$("$ADB" shell dumpsys battery)
    battery_level=$(echo "$battery_dump" | awk '/level:/ {print $2}' | tr -d '\r\n')
    battery_temp=$(echo "$battery_dump" | awk '/temperature:/ {print $2/10}' | tr -d '\r\n')
    battery_status=$(echo "$battery_dump" | awk '/status:/ {print $2}' | tr -d '\r\n')

    case "$battery_status" in
        2) b_stat="Charging (AC/USB)" ;;
        3) b_stat="Discharging" ;;
        4) b_stat="Not Charging" ;;
        5) b_stat="Full" ;;
        *) b_stat="Unknown ($battery_status)" ;;
    esac

    storage_info=$("$ADB" shell df -h /data 2>/dev/null | awk 'NR==2 {print "Used: "$3" / "$2" ("$5" used)"}' || echo "N/A")

    echo -e " ${BOLD}Hardware Model:${RESET}     ${GREEN}$brand $model${RESET} (Android $android_ver)"
    echo -e " ${BOLD}Display Dimensions:${RESET} ${dims} (Native Resolution)"
    echo -e " ${BOLD}Wi-Fi IP Address:${RESET}   ${CYAN}${ip:-Disconnected / Not Available}${RESET}"
    echo -e " ${BOLD}Battery Level:${RESET}      ${YELLOW}${battery_level}%${RESET} (${b_stat})"
    echo -e " ${BOLD}Battery Temp:${RESET}       ${battery_temp}°C"
    echo -e " ${BOLD}Internal Storage:${RESET}   $storage_info"
    echo -e " ${BOLD}ADB Transport:${RESET}      $("$ADB" get-state 2>/dev/null || echo "Unknown")"
    echo ""
}

cmd_backup() {
    check_device
    local target_dir="${1:-$HOME/PhoneBackup_$(date +%Y%m%d_%H%M%S)}"
    mkdir -p "$target_dir"
    log_info "Starting automated device backup to ${BOLD}$target_dir${RESET}..."

    folders=("DCIM" "Pictures" "Download" "Documents" "WhatsApp")
    for f in "${folders[@]}"; do
        log_info "Scanning for /sdcard/$f..."
        if "$ADB" shell "[ -d /sdcard/$f ]" 2>/dev/null; then
            log_info "Pulling /sdcard/$f ..."
            "$ADB" pull "/sdcard/$f" "$target_dir/" || log_warn "Partial pull on $f"
        fi
    done
    log_ok "Backup completed! Files safely archived at: $target_dir"
}

cmd_screenshot() {
    check_device
    local out="${1:-$HOME/Pictures/phone_screenshot_$(date +%Y%m%d_%H%M%S).png}"
    mkdir -p "$(dirname "$out")"
    log_info "Capturing direct framebuffer screenshot..."
    "$ADB" exec-out screencap -p > "$out"
    log_ok "Screenshot saved to: ${BOLD}$out${RESET}"
}

cmd_install() {
    check_device
    local apk="$1"
    if [ -z "$apk" ] || [ ! -f "$apk" ]; then
        log_error "Please provide a valid path to an APK file. Usage: phone install <path-to.apk>"
        exit 1
    fi
    log_info "Sideloading $apk with permission grant flag (-g)..."
    "$ADB" install -r -g "$apk"
    log_ok "Package installed successfully!"
}

