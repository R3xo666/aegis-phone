#!/usr/bin/env bash
# ==============================================================================
# AEGIS-PHONE v5.2: Enterprise Dead-Screen Android Recovery & Control Suite
# Engineered for scrcpy 5.0.1 + ADB on Linux
# Features: Dynamic Resolution, Zero-Injection Clipboard, OTP & Notification Reader,
# Call Log Inspector, Direct Dialer, App Launcher, Battery Watchdog
# ==============================================================================

set -eo pipefail

# Resolve physical directory even when invoked through symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRCPY_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Resolve binaries: Prioritize local bundle, then fallback to system PATH
if [ -x "${SCRCPY_DIR}/adb" ]; then
    ADB="${SCRCPY_DIR}/adb"
elif command -v adb >/dev/null 2>&1; then
    ADB="$(command -v adb)"
else
    ADB="${SCRCPY_DIR}/adb"
fi

if [ -x "${SCRCPY_DIR}/scrcpy" ]; then
    SCRCPY="${SCRCPY_DIR}/scrcpy"
elif command -v scrcpy >/dev/null 2>&1; then
    SCRCPY="$(command -v scrcpy)"
else
    SCRCPY="${SCRCPY_DIR}/scrcpy"
fi

# Formatting / Colors
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
RESET='\033[0m'

# Helpers
log_info()    { echo -e "${CYAN}ℹ [INFO]${RESET} $*"; }
log_ok()      { echo -e "${GREEN}✔ [SUCCESS]${RESET} $*"; }
log_warn()    { echo -e "${YELLOW}⚠ [WARN]${RESET} $*"; }
log_error()   { echo -e "${RED}✖ [ERROR]${RESET} $*" >&2; }
log_banner()  {
    echo -e "${MAGENTA}${BOLD}"
    cat << "EOF"
    ___    ______ _____ _____ _____       ____  __  ______  _   ________
   /   |  / ____// ___// ___// ___/      / __ \/ / / / __ \/ | / / ____/
  / /| | / __/  / / _  \__ \ \__ \ _____/ /_/ / /_/ / / / /  |/ / __/   
 / ___ |/ /___ / /_/ /___/ /___/ /_____/ ____/ __  / /_/ / /|  / /___   
/_/  |_/_____/ \____//____//____/     /_/   /_/ /_/\____/_/ |_/_____/   
EOF
    echo -e "${RESET}${DIM} Enterprise Android Dead-Screen Rescue & Control Suite v5.2${RESET}\n"
}

check_device() {
    local dev_count
    dev_count=$("$ADB" devices | grep -E -v "^List" | grep -c "device$" || true)
    if [ "$dev_count" -eq 0 ]; then
        log_error "No authorized Android device detected!"
        echo -e "\n${YELLOW}Troubleshooting steps:${RESET}"
        echo -e " 1. Ensure USB cable is firmly connected."
        echo -e " 2. Check if device is in charging-only or unauthorized state."
        echo -e " 3. Run: ${BOLD}phone devices${RESET} to inspect connection.\n"
        exit 1
    fi
}

get_screen_dimensions() {
    local dims
    dims=$("$ADB" shell wm size 2>/dev/null | awk -F': ' '/Physical size/ {print $2}' | tr -d '\r\n')
    if [ -z "$dims" ]; then
        dims="1080x2400"
    fi
    echo "$dims"
}

get_phone_ip() {
    local ip
    ip=$("$ADB" shell ip -4 addr show wlan0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1 || true)
    if [ -z "$ip" ]; then
        ip=$("$ADB" shell ip route 2>/dev/null | awk '{print $9}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true)
    fi
    if [ -z "$ip" ]; then
        ip=$("$ADB" shell getprop dhcp.wlan0.ipaddress 2>/dev/null | tr -d '\r\n' || true)
    fi
    echo "$ip"
}

