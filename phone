cmd_bypass_applock() {
    check_device
    log_info "Detecting and suspending active AppLock overlays across known OEM packages..."
    # Universal AppLock packages (Transsion, Xiaomi, Realme/Oppo, Vivo, Samsung, DoMobile)
    local applock_pkgs=(
        "com.transsion.phonemaster"
        "com.miui.securitycenter"
        "com.coloros.safecenter"
        "com.iqoo.secure"
        "com.samsung.android.app.lock"
        "com.domobile.applockwatcher"
        "com.sp.protector.free"
    )
    for pkg in "${applock_pkgs[@]}"; do
        if "$ADB" shell "pm path $pkg" >/dev/null 2>&1; then
            "$ADB" shell am force-stop "$pkg" 2>/dev/null || true
        fi
    done
    log_ok "AppLock overlay processes suspended. Target app should now be directly accessible!"
}

