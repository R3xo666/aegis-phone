# Main Execution Switch
case "$1" in
    ""|-s|--screen-off)
        cmd_mirror_default
        ;;
    -b|--bg|--background)
        log_info "Launching Mirror in background daemon..."
        cmd_mirror_default >/dev/null 2>&1 &
        log_ok "Mirror running in background (PID $!). Terminal is free for input!"
        ;;
    --hq|hq|-hq)
        cmd_mirror_hq
        ;;
    -w|--wifi|-wifi|wifi)
        cmd_mirror_wifi
        ;;
    -e|--eco|eco)
        cmd_mirror_eco
        ;;
    -o|--otg|otg)
        cmd_otg
        ;;
    -a|--audio|audio)
        cmd_audio_only
        ;;
    gui|deck)
        cmd_gui
        ;;
    app-unlock)
        shift
        cmd_app_unlock "$@"
        ;;
    bypass-applock)
        cmd_bypass_applock
        ;;
    unlock)
        shift
        cmd_unlock_and_mirror "$@"
        ;;
    unlock-only)
        shift
        cmd_unlock "$@"
        ;;
    notifs|notifications)
        cmd_notifs
        ;;
    calls|call-log)
        cmd_calls
        ;;
    dial|call)
        shift
        cmd_dial "$@"
        ;;
    answer)
        cmd_answer
        ;;
    hangup|endcall)
        cmd_hangup
        ;;
    open|launch)
        shift
        cmd_app "$@"
        ;;
    watch|battery-watch)
        cmd_battery_watch
        ;;
    status)
        cmd_status
        ;;
    ip)
        check_device
        get_phone_ip
        ;;
    shot|screenshot)
        shift
        cmd_screenshot "$@"
        ;;
    backup)
        shift
        cmd_backup "$@"
        ;;
    clip|clipboard)
        shift
        cmd_clip "$@"
        ;;
    push|send-file)
        shift
        cmd_push "$@"
        ;;
    install)
        shift
        cmd_install "$@"
        ;;
    power)
        check_device
        "$ADB" shell input keyevent KEYCODE_POWER
        log_ok "Power key event sent."
        ;;
    home)
        check_device
        "$ADB" shell input keyevent KEYCODE_HOME
        ;;
    back)
        check_device
        "$ADB" shell input keyevent KEYCODE_BACK
        ;;
    volup)
        check_device
        "$ADB" shell input keyevent KEYCODE_VOLUME_UP
        ;;
    voldn)
        check_device
        "$ADB" shell input keyevent KEYCODE_VOLUME_DOWN
        ;;
    shell)
        check_device
        "$ADB" shell
        ;;
    reboot)
        check_device
        target="${2:-}"
        log_warn "Rebooting device $target..."
        "$ADB" reboot "$target"
        ;;
    devices)
        "$ADB" devices -l
        ;;
    -h|--help|help)
        cmd_help
        ;;
    *)
        log_warn "Unknown command '$1'."
        cmd_help
        exit 1
        ;;
esac
